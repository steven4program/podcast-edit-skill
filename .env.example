# Aliyun FunASR API Key (for transcription)
# Get one at: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-api-key-here

# Gemini API Key (optional, for QA Phase B Layer 2 AI listening)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Aliyun OSS (optional, for large file uploads)
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
# OSS_BUCKET_NAME=your-bucket-name
# OSS_ACCESS_KEY_SECRET=your-access-key-secret

# Active user profile (optional, defaults to "default")
# PODCAST_EDIT_USER=default
